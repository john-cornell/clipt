<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Moq" Version="4.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Clipt\Clipt.csproj" />
    <ProjectReference Include="..\..\src\Clipt.Plugins.Abstractions\Clipt.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Clipt.Plugins.WhereIn\Clipt.Plugins.WhereIn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyPluginAssembliesForTests" AfterTargets="Build">
    <PropertyGroup>
      <WhereInOutput>$(MSBuildProjectDirectory)\..\..\src\Clipt.Plugins.WhereIn\bin\$(Configuration)\net8.0\</WhereInOutput>
      <PluginsOutDir>$(OutputPath)Plugins\</PluginsOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsOutDir)" />
    <Copy SourceFiles="$(WhereInOutput)Clipt.Plugins.WhereIn.dll" DestinationFolder="$(PluginsOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(WhereInOutput)Clipt.Plugins.Abstractions.dll" DestinationFolder="$(PluginsOutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
