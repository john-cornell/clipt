<UserControl x:Class="Clipt.Views.ImageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Clipt.Converters"
             xmlns:help="clr-namespace:Clipt.Help">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Image info bar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10"
                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.BppTooltip}">
                <TextBlock Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11.5"
                           FontWeight="SemiBold" Text="{Binding ImageSummary}" />
            </Border>
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.PixelFormatTooltip}">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                           Text="{Binding PixelFormat, StringFormat='Format: {0}'}" />
            </Border>
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.StrideTooltip}">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                           Text="{Binding Stride, StringFormat='Stride: {0}'}" />
            </Border>
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.PaletteTooltip}">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                           Text="{Binding PaletteInfo}" />
            </Border>
        </WrapPanel>

        <!-- No image (only when no error either) -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasImage}" Value="False" />
                                <Condition Binding="{Binding HasError}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="No image data on clipboard"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       FontSize="14" />
        </StackPanel>

        <!-- Decode error -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Image decode failed"
                       Foreground="{DynamicResource AccentRoseBrush}"
                       HorizontalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap" MaxWidth="500" />
        </StackPanel>

        <!-- Image preview -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundDarkBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Image Source="{Binding ImageSource}"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderOptions.EdgeMode="Aliased" />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
