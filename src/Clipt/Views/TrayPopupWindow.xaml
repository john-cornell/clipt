<Window x:Class="Clipt.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Clipt.Converters"
        xmlns:models="clr-namespace:Clipt.Models"
        Title="Clipt"
        Width="360" Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:AllTrueToVisibilityConverter x:Key="AllTrueToVis" />
        <Style x:Key="TrayLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="10,6,0,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <!-- Options menu -->
                    <Menu DockPanel.Dock="Right"
                          x:Name="TrayOptionsMenu"
                          Background="Transparent"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ForegroundBrush}" />
                            </Style>
                        </Menu.Resources>
                        <MenuItem Header="&#x2261;"
                                  FontSize="16"
                                  Padding="6,2"
                                  ToolTip="Tray popup options">
                            <MenuItem Header="Show tabs"
                                      x:Name="ShowTabsRootMenuItem"
                                      ToolTip="Show or hide optional tray popup tabs" />
                            <Separator />
                            <MenuItem Header="Save group&#x2026;"
                                      Command="{Binding HistoryTab.EnterSaveSelectionModeCommand}"
                                      ToolTip="Select entries to save as a named group" />
                            <MenuItem Header="Reorder items"
                                      IsCheckable="True"
                                      IsChecked="{Binding HistoryTab.ShowMoveControls, Mode=TwoWay}"
                                      ToolTip="Show up/down controls to reorder history" />
                            <MenuItem Header="Long text (More/Less)"
                                      IsCheckable="True"
                                      IsChecked="{Binding HistoryTab.ShowTextExpandControls, Mode=TwoWay}"
                                      ToolTip="Show More and Less under text entries when the summary may be long" />
                            <Separator />
                            <MenuItem Header="Clear">
                                <MenuItem Header="Clear selected&#x2026;"
                                          Command="{Binding HistoryTab.EnterDeleteSelectionModeCommand}"
                                          ToolTip="Select entries in the list, then delete the checked items" />
                                <MenuItem Header="Clear all"
                                          Command="{Binding HistoryTab.ClearAllIncludingClipboardCommand}"
                                          ToolTip="Remove all history and clear the system clipboard" />
                                <MenuItem Header="Clear history only"
                                          Command="{Binding HistoryTab.ClearHistoryOnlyCommand}"
                                          ToolTip="Remove history; keep current clipboard content" />
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <!-- Pin button: far right, close-button style -->
                    <ToggleButton DockPanel.Dock="Right"
                                  IsChecked="{Binding IsPinned}"
                                  Width="36" Height="30" Padding="0"
                                  FontSize="16" Margin="0"
                                  VerticalAlignment="Stretch">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="&#x25CB;" />
                                <Setter Property="ToolTip" Value="Pin window" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="0,4,0,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentLightBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="&#x25C9;" />
                                                    <Setter Property="ToolTip" Value="Unpin window" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Title + expand button together on the left -->
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="&#x2197;"
                            ToolTip="Expand to full window"
                            Command="{Binding ExpandToFullCommand}"
                            Width="26" Height="26" Padding="0"
                            FontSize="14" Margin="6,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentLightBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <TabControl x:Name="TrayTabControl" Grid.Row="1" Margin="0">
                <TabItem Header="Plugins" DataContext="{Binding PluginsTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,6,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Rescan"
                                    Command="{Binding RescanCommand}"
                                    FontSize="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Reload plugins from the Plugins folder" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LoadFailures}" Margin="10,0,10,6">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="#E57373"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2" Text="No plugins found."
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="12" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding DisplayPlugins}"
                                      Margin="0,2,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="10,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Plugin.Name}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding Plugin.Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                                               Margin="0,2,0,0">
                                                        <Run Text="Registered from " />
                                                        <Run Text="{Binding Registration.Source, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical"
                                                            VerticalAlignment="Top" Margin="8,0,0,0">
                                                    <CheckBox Content="Enabled"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              FontSize="10"
                                                              HorizontalAlignment="Right"
                                                              Foreground="{DynamicResource ForegroundBrush}"
                                                              Margin="0,0,0,4" />
                                                    <Button Content="Run"
                                                            Command="{Binding RunCommand}"
                                                            FontSize="10"
                                                            Padding="10,3"
                                                            HorizontalAlignment="Right">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActionPlugin}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  FontSize="10"
                                                                  Foreground="{DynamicResource ForegroundBrush}"
                                                                  Margin="0,0,0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding LastMessage}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastMessage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LastMessageIsError}" Value="True">
                                                                <Setter Property="Foreground" Value="#E57373" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LastMessageIsError}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
                <TabItem Header="Clipboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <StackPanel>
                            <!-- Summary -->
                            <TextBlock Text="{Binding ClipboardSummary}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="12" Margin="0,0,0,8" />

                            <!-- Empty state -->
                            <TextBlock Text="Nothing on the clipboard."
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="12" FontStyle="Italic"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Center" />

                            <!-- Text preview -->
                            <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Text" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,0,4" />
                                <StackPanel Visibility="{Binding TextPreviewStepControlsVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TextPreviewCaption}"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="500" Margin="0,0,4,0" Padding="6,2" FontSize="10"
                                                Command="{Binding SetTrayTextPreviewStepCommand}" CommandParameter="0" />
                                        <Button Content="2K" Margin="0,0,4,0" Padding="6,2" FontSize="10"
                                                Command="{Binding SetTrayTextPreviewStepCommand}" CommandParameter="1" />
                                        <Button Content="8K" Margin="0,0,4,0" Padding="6,2" FontSize="10"
                                                Command="{Binding SetTrayTextPreviewStepCommand}" CommandParameter="2" />
                                        <Button Content="Full" Margin="0,0,4,0" Padding="6,2" FontSize="10"
                                                Command="{Binding SetTrayTextPreviewStepCommand}" CommandParameter="3" />
                                        <Button Content="◀" Margin="6,0,4,0" Padding="6,2" FontSize="10"
                                                ToolTip="Less text"
                                                Command="{Binding RetreatTrayTextPreviewStepCommand}" />
                                        <Button Content="▶" Margin="0,0,0,0" Padding="6,2" FontSize="10"
                                                ToolTip="More text"
                                                Command="{Binding AdvanceTrayTextPreviewStepCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                                <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MaxHeight="140"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12"
                                         Margin="0,0,0,8" />
                            </StackPanel>

                            <!-- Image preview -->
                            <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Image" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,0,4" />
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" MaxHeight="160"
                                        Margin="0,0,0,8">
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </StackPanel>

                            <!-- File preview -->
                            <StackPanel Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Files" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding PreviewFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="History" DataContext="{Binding HistoryTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,6,10,4">
                            <DockPanel
                                Visibility="{Binding ShowNormalHistoryChrome, Converter={StaticResource BoolToVis}}">
                                <ItemsControl DockPanel.Dock="Right"
                                              ItemsSource="{Binding PluginTopHistoryActions}"
                                              Margin="8,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}"
                                                    FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                    Click="PluginActionButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SubActions, RelativeSource={RelativeSource Self}}">
                                                        <ContextMenu.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding Label}" />
                                                                <Setter Property="Command" Value="{Binding Command}" />
                                                            </Style>
                                                        </ContextMenu.ItemContainerStyle>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel
                                Visibility="{Binding ShowSelectionHistoryChrome, Converter={StaticResource BoolToVis}}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Save selected"
                                            Command="{Binding BeginSaveSelectedCommand}"
                                            FontSize="11" Padding="8,2" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowSaveSelectedInChrome}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding PluginHistoryActions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}"
                                                        FontSize="11" Padding="8,2" Margin="0,0,6,0"
                                                        Click="PluginActionButton_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SubActions, RelativeSource={RelativeSource Self}}">
                                                            <ContextMenu.ItemContainerStyle>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                                    <Setter Property="Command" Value="{Binding Command}" />
                                                                </Style>
                                                            </ContextMenu.ItemContainerStyle>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Delete selected"
                                            Command="{Binding DeleteSelectedCommand}"
                                            FontSize="11" Padding="8,2" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDeleteSelectedInChrome}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Cancel"
                                            Command="{Binding CancelSelectionModeCommand}"
                                            Style="{StaticResource TrayLinkButton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Select all"
                                              IsChecked="{Binding SelectAllHeaderChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              FontSize="11"
                                              Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel
                                Visibility="{Binding ShowNamingHistoryChrome, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Content="OK"
                                        Command="{Binding ConfirmSaveGroupCommand}"
                                        FontSize="11" Padding="10,2" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Cancel"
                                        Command="{Binding CancelNamingCommand}"
                                        Style="{StaticResource TrayLinkButton}"
                                        Margin="8,0,0,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Name:"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox MinWidth="120" MaxWidth="180" FontSize="11"
                                             VerticalAlignment="Center"
                                             Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisibleChanged="GroupNameEdit_IsVisibleChanged"
                                             KeyDown="GroupNameEdit_KeyDown" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="No clipboard history yet."
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="12" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DisplayEntries}"
                                      Margin="0,2,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="10,6"
                                            ToolTipService.InitialShowDelay="400"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTipOpening="HistoryEntry_ToolTipOpening"
                                            ToolTip="{Binding PreviewThumbnail}">
                                        <Border.Resources>
                                            <Style TargetType="ToolTip">
                                                <Setter Property="MaxWidth" Value="220" />
                                                <Setter Property="MaxHeight" Value="220" />
                                                <Setter Property="Padding" Value="4" />
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Image Source="{Binding}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Border.Resources>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Visibility="{Binding DataContext.ShowMoveControls, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                <Button Content="&#x25B2;" FontSize="9" Padding="2,0"
                                                        Command="{Binding MoveUpCommand}"
                                                        ToolTip="Move up in history">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MoveUpCommand}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="&#x25BC;" FontSize="9" Padding="2,0"
                                                        Command="{Binding MoveDownCommand}"
                                                        ToolTip="Move down in history">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MoveDownCommand}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <!-- Editable name row -->
                                            <TextBlock Grid.Column="2" Grid.ColumnSpan="4" Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,2" Cursor="Hand"
                                                       MouseLeftButtonDown="HistoryEntryName_MouseLeftButtonDown"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="Click to edit">
                                                        <ToolTip.ContentTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ToolTip.ContentTemplate>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <TextBox Grid.Column="2" Grid.ColumnSpan="4" Grid.Row="0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" FontWeight="SemiBold"
                                                     Margin="0,0,0,2" Padding="0"
                                                     IsVisibleChanged="HistoryEntryNameEdit_IsVisibleChanged"
                                                     LostFocus="HistoryEntryNameEdit_LostFocus"
                                                     KeyDown="HistoryEntryNameEdit_KeyDown"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock Grid.Column="2" Grid.Row="1"
                                                       Text="{Binding ContentTypeLabel}"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource AccentLightBrush}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />

                                            <Button Grid.Column="3" Grid.Row="1"
                                                    Command="{Binding PreviewCommand}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Click to preview full size">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PreviewCommand}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding InlineThumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Image Source="{Binding InlineThumbnail}"
                                                       Width="28" Height="28"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Button>

                                            <StackPanel Grid.Column="4" Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SummaryDisplay}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="160" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                                            <Binding Path="SummaryExpandChromeVisible" />
                                                            <Binding Path="DataContext.ShowTextExpandControls"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <Button Content="More" FontSize="10" Padding="8,1" Margin="0,0,4,0"
                                                            Command="{Binding ExpandHistorySummaryCommand}" />
                                                    <Button Content="Less" FontSize="10" Padding="8,1"
                                                            Command="{Binding RetreatHistorySummaryCommand}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="5" Grid.Row="1"
                                                       Text="{Binding RelativeTime}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />

                                            <Grid Grid.Column="2" Grid.ColumnSpan="4" Grid.Row="2"
                                                  Margin="0,4,0,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding OwnerDisplay}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,8,0"
                                                           ToolTip="Process that owned the clipboard when this was captured" />
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Block"
                                                            FontSize="9" Padding="6,0" Margin="0,0,6,0"
                                                            Command="{Binding BlockOwnerCommand}"
                                                            ToolTip="Block this process and remove its history entries">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanBlockOwner}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock Text="blocked"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOwnerBlocked}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Content="Restore" FontSize="10"
                                                            Padding="8,1"
                                                            Command="{Binding RestoreCommand}" Margin="0,0,4,0"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                    <Button Content="Force" FontSize="10"
                                                            Padding="8,1"
                                                            Command="{Binding ForceCommand}" Margin="0,0,4,0"
                                                            ToolTip="Re-push this item onto the clipboard even though Clipt thinks it's already there (use if paste isn't picking it up)"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                    <Button Content="X" FontSize="10"
                                                            Padding="6,1" ToolTip="Delete"
                                                            Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Groups" DataContext="{Binding GroupsTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="10,6,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="New folder&#x2026;"
                                    Command="{Binding CreateFolderCommand}"
                                    FontSize="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Create a folder to file saved groups under" />
                            <Button Grid.Column="2"
                                    Content="Import group&#x2026;"
                                    Command="{Binding ImportGroupCommand}"
                                    FontSize="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Add a group from a .cliptgroup file from another PC" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sort:" FontSize="10"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Grid.Column="1" FontSize="10" Padding="4,1" VerticalAlignment="Center"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SortMode, Mode=TwoWay}">
                                <ComboBoxItem Content="Date created" Tag="{x:Static models:GroupSortMode.DateCreated}" />
                                <ComboBoxItem Content="Alphabetical" Tag="{x:Static models:GroupSortMode.Alphabetical}" />
                                <ComboBoxItem Content="Size" Tag="{x:Static models:GroupSortMode.ItemCount}" />
                                <ComboBoxItem Content="Custom" Tag="{x:Static models:GroupSortMode.Custom}" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Drag a group onto a folder, or use &quot;Move to folder&#x2026;&quot;"
                                       FontSize="9" FontStyle="Italic"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding ShowMoveControls, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <TextBlock Grid.Column="2" Text="Use &#x25B2;&#x25BC; to reorder within a folder"
                                       FontSize="9" FontStyle="Italic"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding ShowMoveControls, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Text="No saved groups."
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   FontSize="12" FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Sections}"
                                      Margin="0,2,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Background="{DynamicResource SurfaceLightBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="8,4"
                                                AllowDrop="True"
                                                DragOver="GroupSection_DragOver"
                                                Drop="GroupSection_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" FontSize="8" Padding="4,0" Margin="0,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Command="{Binding ToggleCollapsedCommand}"
                                                        ToolTip="Expand/collapse">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="&#x25BC;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                    <Setter Property="Content" Value="&#x25B6;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="11" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           MouseLeftButtonDown="GroupSectionName_MouseLeftButtonDown"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="11" FontWeight="Bold" Padding="0"
                                                         IsVisibleChanged="GroupSectionNameEdit_IsVisibleChanged"
                                                         LostFocus="GroupSectionNameEdit_LostFocus"
                                                         KeyDown="GroupSectionNameEdit_KeyDown"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Grid.Column="2" Text="{Binding ItemCountText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                                           VerticalAlignment="Center" Margin="8,0" />

                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <Button Content="&#x25B2;" FontSize="9" Padding="2,0"
                                                            Command="{Binding MoveUpCommand}"
                                                            ToolTip="Move folder up">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MoveUpCommand}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="&#x25BC;" FontSize="9" Padding="2,0"
                                                            Command="{Binding MoveDownCommand}"
                                                            ToolTip="Move folder down">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MoveDownCommand}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <Button Grid.Column="4" Content="X" FontSize="10"
                                                        Padding="6,1" ToolTip="Delete folder (groups move to Ungrouped)"
                                                        Command="{Binding DeleteCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeleteCommand}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Groups}"
                                                      Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="0,0,0,1" Padding="10,6"
                                                                Background="Transparent"
                                                                PreviewMouseLeftButtonDown="GroupRow_PreviewMouseLeftButtonDown"
                                                                PreviewMouseMove="GroupRow_PreviewMouseMove">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0" FontSize="8" Padding="4,0" Margin="0,0,4,0"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Click="GroupExpandToggle_Click"
                                                                        ToolTip="Show/hide the clips in this group">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Content" Value="&#x25B6;" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="Content" Value="&#x25BC;" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <Button Content="&#x25B2;" FontSize="9" Padding="2,0"
                                                                            Command="{Binding MoveUpCommand}"
                                                                            ToolTip="Move up">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding MoveUpCommand}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    <Button Content="&#x25BC;" FontSize="9" Padding="2,0"
                                                                            Command="{Binding MoveDownCommand}"
                                                                            ToolTip="Move down">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding MoveDownCommand}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Name}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,0,2" Cursor="Hand"
                                                                           MouseLeftButtonDown="GroupEntryName_MouseLeftButtonDown"
                                                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" />
                                                                                <TextBlock Text="Click to rename" Opacity="0.7" />
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                                <TextBox Grid.Column="2"
                                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="11" FontWeight="SemiBold"
                                                                         Margin="0,0,0,2" Padding="0"
                                                                         IsVisibleChanged="GroupEntryNameEdit_IsVisibleChanged"
                                                                         LostFocus="GroupEntryNameEdit_LostFocus"
                                                                         KeyDown="GroupEntryNameEdit_KeyDown"
                                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding ItemCountText}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,8,0" />
                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding RelativeTime}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0" />

                                                                <Menu Grid.Column="5"
                                                                      Background="Transparent"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,4,0">
                                                                    <MenuItem Header="Restore" FontSize="10" Padding="6,2">
                                                                        <MenuItem Header="Clear &amp; restore"
                                                                                  Command="{Binding RestoreCommand}"
                                                                                  CommandParameter="{x:Static models:GroupRestoreMode.ClearAndRestore}"
                                                                                  ToolTip="Replace history with this group" />
                                                                        <MenuItem Header="Add to top"
                                                                                  Command="{Binding RestoreCommand}"
                                                                                  CommandParameter="{x:Static models:GroupRestoreMode.AddToTop}"
                                                                                  ToolTip="Insert group at top of history (newest first)" />
                                                                        <MenuItem Header="Add to bottom"
                                                                                  Command="{Binding RestoreCommand}"
                                                                                  CommandParameter="{x:Static models:GroupRestoreMode.AddToBottom}"
                                                                                  ToolTip="Append group after current history" />
                                                                    </MenuItem>
                                                                    <MenuItem Header="Export&#x2026;"
                                                                              Command="{Binding ExportCommand}"
                                                                              FontSize="10"
                                                                              Padding="6,2"
                                                                              ToolTip="Save this group to a .cliptgroup file for another PC" />
                                                                </Menu>

                                                                <Button Grid.Column="6" Content="&#x2026;" FontSize="10"
                                                                        Padding="6,1" Margin="0,0,4,0"
                                                                        ToolTip="Move to folder&#x2026;"
                                                                        Click="MoveToFolderButton_Click"
                                                                        VerticalAlignment="Center" />

                                                                <Button Grid.Column="7" Content="X" FontSize="10"
                                                                        Padding="6,1" ToolTip="Delete group"
                                                                        Command="{Binding DeleteCommand}"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl ItemsSource="{Binding Entries}"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,0,0,1" Padding="28,4,10,4"
                                                                            Background="Transparent">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                <Button Content="&#x25B2;" FontSize="8" Padding="2,0"
                                                                                        Command="{Binding MoveUpCommand}"
                                                                                        ToolTip="Move up">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding MoveUpCommand}" Value="{x:Null}">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                                <Button Content="&#x25BC;" FontSize="8" Padding="2,0"
                                                                                        Command="{Binding MoveDownCommand}"
                                                                                        ToolTip="Move down">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding MoveDownCommand}" Value="{x:Null}">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Name}"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                                       MouseLeftButtonDown="GroupItemName_MouseLeftButtonDown"
                                                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                                                <TextBlock.ToolTip>
                                                                                    <ToolTip>
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" />
                                                                                            <TextBlock Text="Click to rename" Opacity="0.7" />
                                                                                        </StackPanel>
                                                                                    </ToolTip>
                                                                                </TextBlock.ToolTip>
                                                                            </TextBlock>
                                                                            <TextBox Grid.Column="1"
                                                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                     FontSize="10" Padding="0"
                                                                                     VerticalAlignment="Center"
                                                                                     IsVisibleChanged="GroupItemNameEdit_IsVisibleChanged"
                                                                                     LostFocus="GroupItemNameEdit_LostFocus"
                                                                                     KeyDown="GroupItemNameEdit_KeyDown"
                                                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding DetailText}"
                                                                                       FontSize="9"
                                                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="8,0,8,0" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding RelativeTime}"
                                                                                       FontSize="9"
                                                                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,8,0" />

                                                                            <Button Grid.Column="4" Content="X" FontSize="9"
                                                                                    Padding="5,0" ToolTip="Remove this clip from the group"
                                                                                    Command="{Binding DeleteCommand}"
                                                                                    VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>


            </TabControl>
        </Grid>
    </Border>
</Window>
