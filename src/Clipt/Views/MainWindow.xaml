<Window x:Class="Clipt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Clipt.Views"
        xmlns:converters="clr-namespace:Clipt.Converters"
        xmlns:help="clr-namespace:Clipt.Help"
        Title="Clipt"
        Icon="pack://application:,,,/Icons/icon.ico"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header / Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="?" IsChecked="{Binding IsHelpVisible}"
                                  ToolTip="Toggle detailed help panel for the current tab"
                                  Width="30" Height="30" Padding="0"
                                  FontWeight="Bold" FontSize="13"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />
                    <CheckBox Content="Auto-refresh" IsChecked="{Binding AutoRefresh}"
                              ToolTip="{x:Static help:HelpContent.AutoRefreshTooltip}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Refresh Now"
                            Command="{Binding RefreshCommand}"
                            Padding="14,6" FontSize="12.5" />
                </StackPanel>

                <!-- Brand Header -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentGradient}" Margin="0,0,10,0">
                        <TextBlock Text="C" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clipt" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Clipboard Inspector &amp; Diagnostic Tool" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Help panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundDarkBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                MaxHeight="200"
                Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <ItemsControl ItemsSource="{Binding CurrentHelpEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceDarkBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Term}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Tab area -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="0">
            <TabItem Header="Text">
                <views:TextTabView DataContext="{Binding TextTab}" />
            </TabItem>
            <TabItem Header="Hex">
                <views:HexTabView DataContext="{Binding HexTab}" />
            </TabItem>
            <TabItem Header="Image">
                <views:ImageTabView DataContext="{Binding ImageTab}" />
            </TabItem>
            <TabItem Header="Rich Content">
                <views:RichContentTabView DataContext="{Binding RichContentTab}" />
            </TabItem>
            <TabItem Header="File Drop">
                <views:FileDropTabView DataContext="{Binding FileDropTab}" />
            </TabItem>
            <TabItem Header="All Formats">
                <views:FormatsTabView DataContext="{Binding FormatsTab}" />
            </TabItem>
            <TabItem Header="Native / Memory">
                <views:NativeTabView DataContext="{Binding NativeTab}" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem Content="{Binding StatusTimestamp}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="4,2" />
            <StatusBarItem Content="{Binding StatusSequence}" Foreground="{DynamicResource TextSecondaryBrush}"
                           ToolTip="{x:Static help:HelpContent.SeqStatusTooltip}" />
            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="4,2" />
            <StatusBarItem Content="{Binding StatusFormats}" Foreground="{DynamicResource TextSecondaryBrush}"
                           ToolTip="{x:Static help:HelpContent.FormatsCountTooltip}" />
            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="4,2" />
            <StatusBarItem Content="{Binding StatusOwner}" Foreground="{DynamicResource TextSecondaryBrush}"
                           ToolTip="{x:Static help:HelpContent.OwnerStatusTooltip}" />
        </StatusBar>
    </Grid>
</Window>
