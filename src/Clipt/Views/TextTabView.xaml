<UserControl x:Class="Clipt.Views.TextTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Clipt.Converters"
             xmlns:help="clr-namespace:Clipt.Help">
    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- Stats cards -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatLabel}" Text="Characters:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding CharacterCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatLabel}" Text="Lines:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LineCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.NullTerminatorTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatLabel}" Text="Null at:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding NullTerminatorPosition}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" ToolTip="{x:Static help:HelpContent.LocaleLcidTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatLabel}" Text="Locale:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LocaleInfo}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Text="{Binding EncodingStats}" Margin="2,0,0,8"
                   ToolTip="{x:Static help:HelpContent.EncodingStatsTooltip}" />

        <!-- Edit toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="Apply to Clipboard" Command="{Binding ApplyTextToClipboardCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,0" Padding="12,5" FontSize="11.5" />
                <Button Command="{Binding ToggleEditingCommand}" Padding="12,5" FontSize="11.5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Content" Value="Edit" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Content" Value="Cancel" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding EditStatusMessage}"
                       Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11.5"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Unicode text -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="CF_UNICODETEXT (UTF-16)"
                       Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="0,0,0,4"
                       ToolTip="{x:Static help:HelpContent.CfUnicodeTextTooltip}" />
            <TextBox x:Name="UnicodeTextBox"
                     Text="{Binding UnicodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MonoText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsInactiveSelectionHighlightEnabled="True"
                     IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}" />
        </DockPanel>

        <!-- ANSI header -->
        <TextBlock Grid.Row="4" Text="CF_TEXT (ANSI)"
                   Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11"
                   FontWeight="SemiBold" Margin="0,10,0,4"
                   ToolTip="{x:Static help:HelpContent.CfTextTooltip}" />

        <TextBox x:Name="AnsiTextBox"
                 Grid.Row="5" Text="{Binding AnsiText, Mode=OneWay}"
                 Style="{DynamicResource MonoText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsInactiveSelectionHighlightEnabled="True" />

        <!-- OEM header -->
        <TextBlock Grid.Row="6" Text="CF_OEMTEXT (OEM / CP437)"
                   Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11"
                   FontWeight="SemiBold" Margin="0,10,0,4"
                   ToolTip="{x:Static help:HelpContent.CfOemTextTooltip}" />

        <TextBox x:Name="OemTextBox"
                 Grid.Row="7" Text="{Binding OemText, Mode=OneWay}"
                 Style="{DynamicResource MonoText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsInactiveSelectionHighlightEnabled="True" />
    </Grid>
</UserControl>
