<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clipt.Plugins.SaveToGroup</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clipt.Plugins.Abstractions\Clipt.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CopyToCliptPluginsFolder" AfterTargets="Build">
    <PropertyGroup>
      <CliptPluginsDir>$(MSBuildThisFileDirectory)..\Clipt\bin\$(Configuration)\net8.0-windows\Plugins\</CliptPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(CliptPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CliptPluginsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Clipt.Plugins.Abstractions.dll" DestinationFolder="$(CliptPluginsDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)Clipt.Plugins.Abstractions.dll')" />
  </Target>

</Project>
